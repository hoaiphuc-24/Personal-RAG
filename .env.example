# demo: offline excerpt retrieval; openai: real model and semantic embeddings
RAG_PROVIDER=demo
PROJECT_NAME=Personal AgenticRAG
OWNER_NAME=You
# Only needed for RAG_PROVIDER=openai. Never put this key in frontend code.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
# Relative paths are resolved from THIS project, never the parent folder.
DATA_DIR=data
CHUNK_SIZE=900
CHUNK_OVERLAP=150
MAX_AGENT_STEPS=5
MAX_UPLOAD_MB=10
